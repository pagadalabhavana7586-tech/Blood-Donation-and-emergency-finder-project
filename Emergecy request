
<!DOCTYPE html>
<html lang="en" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, initial-scale=1">
    <title>Emergency Blood Request</title>
    <link rel="stylesheet" th:href="@{/style.css}">
</head>
<body>

<header>
    <h1>Emergency Blood Request</h1>
</header>

<div class="form-container">

    <h2>Request Blood</h2>

    <form th:action="@{/requests/new}"
          th:object="${bloodRequest}"
          method="post">

        <label>Patient Name</label>
        <input type="text"
               th:field="*{patientName}"
               required>

        <label>Blood Group</label>
        <select th:field="*{bloodGroup}" required>
            <option value="">Select Blood Group</option>
            <option>A+</option>
            <option>A-</option>
            <option>B+</option>
            <option>B-</option>
            <option>AB+</option>
            <option>AB-</option>
            <option>O+</option>
            <option>O-</option>
        </select>

        <label>City</label>
        <input type="text"
               th:field="*{city}"
               required>

        <label>Hospital Name</label>
        <input type="text"
               th:field="*{hospital}"
               required>

        <label>Contact Number</label>
        <input type="tel"
               th:field="*{contactNumber}"
               pattern="[0-9]{10}"
               required>

        <label>Urgency</label>
        <select th:field="*{urgency}" required>
            <option>Normal</option>
            <option>Urgent</option>
            <option>Emergency</option>
        </select>

        <button type="submit">
            Submit Blood Request
        </button>
    </form>

    <p class="notice">
        Submitting this form does not notify a hospital
        or dispatch emergency services.
    </p>

    <a th:href="@{/}">Back to Home</a>
</div>

</body>
</html>
