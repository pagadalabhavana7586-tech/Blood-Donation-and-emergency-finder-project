
<!DOCTYPE html>
<html lang="en" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, initial-scale=1">
    <title>LifeLink | Blood Donation Finder</title>
    <link rel="stylesheet" th:href="@{/style.css}">
</head>
<body>

<header>
    <h1>LifeLink</h1>
    <p>Blood Donation & Emergency Finder</p>
</header>

<nav>
    <a th:href="@{/}">Home</a>
    <a th:href="@{/donors}">Find Donors</a>
    <a th:href="@{/donors/register}">Register</a>
    <a th:href="@{/requests/new}">Request Blood</a>
</nav>

<section class="hero">
    <h2>Donate Blood, Save Lives</h2>
    <p>
        Connecting voluntary blood donors
        with people in need.
    </p>

    <div class="buttons">
        <a class="btn" th:href="@{/donors}">
            Find Blood Donors
        </a>

        <a class="btn" th:href="@{/donors/register}">
            Become a Donor
        </a>

        <a class="btn" th:href="@{/requests/new}">
            Emergency Blood Request
        </a>
    </div>

    <p th:if="${param.requestSubmitted}" class="success">
        Your blood request has been submitted successfully.
    </p>
</section>

<section class="features">
    <h2>Our Services</h2>

    <div class="cards">
        <div class="card">
            <h3>Donor Registration</h3>
            <p>Register as a voluntary blood donor.</p>
        </div>

        <div class="card">
            <h3>Find Donors</h3>
            <p>Search by blood group and location.</p>
        </div>

        <div class="card">
            <h3>Emergency Requests</h3>
            <p>Submit and manage blood requirements.</p>
        </div>
    </div>
</section>

<footer>
    <p>
        LifeLink | Java Summer Internship Project
    </p>
    <p>
        For medical emergencies, contact a hospital
        or emergency service directly.
    </p>
</footer>

</body>
</html>
