
<!DOCTYPE html>
<html lang="en" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, initial-scale=1">
    <title>Donor Registration</title>
    <link rel="stylesheet" th:href="@{/style.css}">
</head>
<body>

<header>
    <h1>Become a Blood Donor</h1>
</header>

<div class="form-container">
    <h2>Donor Registration</h2>

    <form th:action="@{/donors/register}"
          th:object="${donor}"
          method="post">

        <label>Full Name</label>
        <input type="text"
               th:field="*{name}"
               required>

        <label>Blood Group</label>
        <select th:field="*{bloodGroup}" required>
            <option value="">Select Blood Group</option>
            <option>A+</option>
            <option>A-</option>
            <option>B+</option>
            <option>B-</option>
            <option>AB+</option>
            <option>AB-</option>
            <option>O+</option>
            <option>O-</option>
        </select>

        <label>City</label>
        <input type="text"
               th:field="*{city}"
               required>

        <label>Phone Number</label>
        <input type="tel"
               th:field="*{phone}"
               pattern="[0-9]{10}"
               required>

        <p class="notice">
            Demo only: contact details will be visible
            in the donor directory. Use test data.
        </p>

        <button type="submit">
            Register as Donor
        </button>
    </form>

    <a th:href="@{/}">Back to Home</a>
</div>

</body>
</html>
